# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
# Local example: postgresql://postgres:postgres@localhost:5432/procucev_stt
# Cloud example (Render/Neon/Supabase): postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/procucev_stt

# Primary Real-Time STT: Gemini Live API (Free tier / AI Studio key)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live

# Optional Self-Hosted Open-Source STT (e.g., faster-whisper-server / whisper.cpp)
WHISPER_API_URL=
